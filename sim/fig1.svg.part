  <text class="rail" x="594" y="235"></text>
  <text class="rail" x="594" y="235">IN1: U1 pin 2</text>
  <circle class="wire" cx="60" cy="420" r="5" fill="var(--bg)"/>
  <text class="rail" x="74" y="425"></text>
  <text class="rail" x="50" y="406">LINE R (J2-3)</text>
