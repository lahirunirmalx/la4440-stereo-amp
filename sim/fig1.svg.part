  <path class="wire" d="M298 368 H342 M306 376 H334 M314 384 H326"/>
  <circle class="dot" cx="320" cy="230" r="4"/>
  <path class="wire" d="M320 230 L373 230"/>
  <path class="wire" d="M373 208 V252"/>
  <path class="wire" d="M387 208 V252"/>
  <path class="wire" d="M387 230 L440 230"/>
